# BHOJORA Environment Variable Template (Checkpoint 04 Baseline)
# Copy to .env for local development. Never commit .env files or real secrets.

NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CITY_CODE=KOLKATA
DEFAULT_CURRENCY=INR
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT_MS=10000

# Database & Cache (Provisioned in Checkpoints 06+)
MONGODB_URI=mongodb://127.0.0.1:27017/bhojora_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
MONGODB_AUTO_INDEX=true
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security (Generate strong local-only dev secrets >= 32 chars)
JWT_ACCESS_SECRET=replace-with-local-dev-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-local-dev-refresh-secret-min-32-chars

# External Sandboxes (Configured only in dedicated integration checkpoints)
GOOGLE_MAPS_API_KEY=
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
S3_BUCKET_PRIVATE=
S3_REGION=ap-south-1
