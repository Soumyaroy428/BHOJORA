{
  "openapi": "3.1.0",
  "info": {
    "title": "BHOJORA Platform API",
    "version": "1.0.0",
    "description": "Official API contract for the BHOJORA Food Delivery and Independent Kitchen Trust Transparency Platform (Kolkata Pilot & Multi-City Engine). All financial values use integer paise (INR). Timestamps use ISO 8601 UTC.",
    "contact": {
      "name": "Bhojora Engineering",
      "url": "https://bhojora.vercel.app"
    }
  },
  "servers": [
    {
      "url": "https://api.bhojora.in/api/v1",
      "description": "Production API Server"
    },
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "WebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Webhook-Signature"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Unique UUID v4 preventing duplicate financial or order mutations."
      }
    },
    "schemas": {
      "PaginationMeta": {
        "type": "object",
        "required": ["hasMore", "limit"],
        "properties": {
          "cursor": { "type": ["string", "null"] },
          "nextCursor": { "type": ["string", "null"] },
          "hasMore": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 1 },
          "totalCount": { "type": "integer", "minimum": 0 }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "IDEMPOTENCY_CONFLICT",
          "ITEM_PRICE_CHANGED",
          "OUTLET_OUT_OF_ZONE",
          "CRITICAL_VIOLATION_SUSPENDED",
          "SELF_APPROVAL_PROHIBITED",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_SERVER_ERROR"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error", "requestId", "timestamp"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "requestId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "message": { "type": "string", "example": "Invalid payload parameters" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["issue"],
                  "properties": {
                    "field": { "type": "string" },
                    "issue": { "type": "string" },
                    "code": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "SafetyStatusEnum": {
        "type": "string",
        "enum": [
          "NOT_INSPECTED",
          "PENDING_REVIEW",
          "VERIFIED_CLEAN",
          "ACTION_REQUIRED",
          "SUSPENDED",
          "EXPIRED"
        ]
      },
      "MoneyPaise": {
        "type": "integer",
        "minimum": 0,
        "description": "Monetary amount strictly in integer paise (1 INR = 100 paise)."
      },
      "GeoPoint": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Point"] },
          "coordinates": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2,
            "example": [88.437, 22.58]
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "API Liveness Health Check",
        "security": [],
        "tags": ["System"],
        "responses": {
          "200": { "description": "API service process liveness status." }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "API Readiness Probe",
        "security": [],
        "tags": ["System"],
        "responses": {
          "200": { "description": "API service is ready to accept traffic." },
          "503": { "description": "API service or dependency readiness probe failed or shutting down." }
        }
      }
    },
    "/auth/otp/send": {
      "post": {
        "summary": "Send 6-digit SMS OTP",
        "security": [],
        "tags": ["Identity"],
        "responses": {
          "200": { "description": "OTP sent successfully" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "summary": "Verify OTP and issue tokens",
        "security": [],
        "tags": ["Identity"],
        "responses": {
          "200": { "description": "Authenticated session issued" },
          "401": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register user account",
        "security": [],
        "tags": ["Identity"],
        "responses": { "201": { "description": "Account created" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Password-based authentication",
        "security": [],
        "tags": ["Identity"],
        "responses": { "200": { "description": "Tokens issued" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token and revoke session family on replay detection",
        "security": [],
        "tags": ["Identity"],
        "responses": {
          "200": { "description": "New token pair issued" },
          "401": { "description": "Expired, invalid, or replayed refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke current authenticated session and clear auth cookies",
        "tags": ["Identity"],
        "responses": { "200": { "description": "Current session revoked" } }
      }
    },
    "/auth/logout-all": {
      "post": {
        "summary": "Revoke all active sessions for the current user",
        "tags": ["Identity"],
        "responses": { "200": { "description": "All active sessions revoked" } }
      }
    },
    "/auth/sessions": {
      "get": {
        "summary": "List active and recent sessions for the current user",
        "tags": ["Identity"],
        "responses": { "200": { "description": "Session list" } }
      }
    },
    "/auth/sessions/{sessionId}": {
      "delete": {
        "summary": "Revoke a specific session belonging to the current user",
        "tags": ["Identity"],
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Session revoked" },
          "404": { "description": "Session not found" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Initiate account recovery with enumeration-safe response",
        "security": [],
        "tags": ["Identity"],
        "responses": { "200": { "description": "Recovery request accepted" } }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Verify single-use recovery token, update password, and revoke all active sessions",
        "security": [],
        "tags": ["Identity"],
        "responses": {
          "200": { "description": "Password reset and active sessions revoked" },
          "401": { "description": "Expired, invalid, or replayed recovery token" }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get current authenticated user profile",
        "tags": ["Users"],
        "responses": {
          "200": { "description": "User profile details" },
          "401": { "description": "Authentication required or session revoked" }
        }
      },
      "patch": {
        "summary": "Update user language preference (en-IN / bn-IN) and profile details",
        "tags": ["Users"],
        "responses": {
          "200": { "description": "Profile updated" },
          "401": { "description": "Authentication required or session revoked" }
        }
      }
    },
    "/addresses": {
      "get": {
        "summary": "List saved Kolkata delivery addresses",
        "tags": ["Users"],
        "responses": { "200": { "description": "Array of saved addresses" } }
      },
      "post": {
        "summary": "Save new Kolkata landmark address with GeoJSON Point",
        "tags": ["Users"],
        "responses": { "201": { "description": "Address saved" } }
      }
    },
    "/restaurants": {
      "get": {
        "summary": "Geospatial & filterable restaurant discovery with cursor pagination and truthful trust badges",
        "security": [],
        "tags": ["Discovery"],
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 80 } },
          { "name": "zoneId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "lng", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "lat", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "openNow", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "verifiedOnly", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "safetyStatus", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "minSafetyScore", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 100 } },
          { "name": "dietary", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PURE_VEG", "NON_VEG", "EGG"] } },
          { "name": "excludeAllergens", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "maxPricePaise", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0 } },
          { "name": "maxEtaMinutes", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 5, "maximum": 120 } },
          { "name": "maxDistanceMeters", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 500, "maximum": 25000 } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["relevance", "distance", "eta", "price_asc", "price_desc", "safety_score"] } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 25 } }
        ],
        "responses": {
          "200": { "description": "Cursor-paginated serviceable restaurant list with non-misleading trustBadge" },
          "429": { "description": "Public discovery rate limit exceeded (RATE_LIMITED)" }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Unified restaurant, cuisine, dish & allergen-aware search with cursor pagination and anti-sponsored ranking disclosure",
        "security": [],
        "tags": ["Discovery"],
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 80 } },
          { "name": "zoneId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "lng", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "lat", "in": "query", "required": false, "schema": { "type": "number" } },
          { "name": "openNow", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "verifiedOnly", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "safetyStatus", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "minSafetyScore", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 100 } },
          { "name": "dietary", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PURE_VEG", "NON_VEG", "EGG"] } },
          { "name": "excludeAllergens", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "maxPricePaise", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0 } },
          { "name": "maxEtaMinutes", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 5, "maximum": 120 } },
          { "name": "maxDistanceMeters", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 500, "maximum": 25000 } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["relevance", "distance", "eta", "price_asc", "price_desc", "safety_score"] } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 25 } }
        ],
        "responses": {
          "200": { "description": "Matching outlets, dish matches, rankingDisclosure, and PaginationMeta" },
          "400": { "description": "Invalid query bounds, coordinates, or pagination cursor" },
          "429": { "description": "Public search rate limit exceeded (RATE_LIMITED)" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List curated Kolkata cuisine, dietary & verified-trust discovery collections with live counts",
        "security": [],
        "tags": ["Discovery"],
        "parameters": [
          { "name": "zoneId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Curated discovery collections" },
          "429": { "description": "Public discovery rate limit exceeded (RATE_LIMITED)" }
        }
      }
    },
    "/zones": {
      "get": {
        "summary": "List Kolkata GeoJSON Polygon serviceability corridors and fee policies",
        "security": [],
        "tags": ["Discovery"],
        "responses": { "200": { "description": "Delivery zone list" } }
      }
    },
    "/serviceability": {
      "get": {
        "summary": "Server-computed point-in-polygon and Haversine radius check for [lng, lat]",
        "security": [],
        "tags": ["Discovery"],
        "parameters": [
          { "name": "lng", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "lat", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "outletId", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Authoritative serviceability and IST open status" } }
      }
    },
    "/serviceability/check": {
      "post": {
        "summary": "Server-computed serviceability evaluation from GeoJSON Point payload",
        "security": [],
        "tags": ["Discovery"],
        "responses": { "200": { "description": "Authoritative serviceability result" } }
      }
    },
    "/outlets/{outletId}": {
      "get": {
        "summary": "Public-safe outlet detail with map pin, radius, Asia/Kolkata live status & FSSAI notice",
        "security": [],
        "tags": ["Discovery"],
        "parameters": [{ "name": "outletId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Public outlet operational detail" } }
      }
    },
    "/restaurant/outlets": {
      "get": {
        "summary": "List tenant-owned partner outlets with live Asia/Kolkata status",
        "tags": ["Partner Operations"],
        "responses": { "200": { "description": "Tenant outlet list" } }
      },
      "post": {
        "summary": "Create additional branch outlet for an approved restaurant (initializes NOT_INSPECTED)",
        "tags": ["Partner Operations"],
        "responses": { "201": { "description": "Branch outlet created" } }
      }
    },
    "/restaurant/outlets/{outletId}": {
      "patch": {
        "summary": "Update tenant outlet GeoJSON [lng, lat] pin, radius, or pause status",
        "tags": ["Partner Operations"],
        "parameters": [{ "name": "outletId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Updated outlet operations" } }
      }
    },
    "/restaurant/outlets/{outletId}/hours": {
      "put": {
        "summary": "Replace weekly Asia/Kolkata operating slots and special holiday closures",
        "tags": ["Partner Operations"],
        "parameters": [{ "name": "outletId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Updated operating schedule and IST status" } }
      }
    },
    "/outlets/{id}/menu": {
      "get": {
        "summary": "Fetch outlet active catalog, items in paise, and declared allergens",
        "security": [],
        "tags": ["Catalog"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Structured menu categories and items" } }
      }
    },
    "/restaurant/outlets/{outletId}/menu": {
      "get": {
        "summary": "Read partner outlet menu catalog and scoped catalog audit trail",
        "tags": ["Catalog"],
        "parameters": [{ "name": "outletId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Partner outlet catalog and audit log" } }
      }
    },
    "/restaurant/menu/categories": {
      "post": {
        "summary": "Create menu category on tenant-owned outlet (restaurant:menu:manage)",
        "tags": ["Catalog"],
        "responses": { "201": { "description": "Category created and audited" } }
      }
    },
    "/restaurant/menu/categories/{categoryId}": {
      "patch": {
        "summary": "Update menu category name, order, or active status (audited)",
        "tags": ["Catalog"],
        "parameters": [{ "name": "categoryId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Category updated and audited" } }
      }
    },
    "/restaurant/menu/items": {
      "post": {
        "summary": "Create menu item with integer paise price, dietary badge, confirmed allergens, variants, and add-ons",
        "tags": ["Catalog"],
        "responses": { "201": { "description": "Menu item created and audited" } }
      }
    },
    "/restaurant/menu/items/{itemId}": {
      "patch": {
        "summary": "Update menu item integer paise pricing, allergens, customizations, or availability (audited)",
        "tags": ["Catalog"],
        "parameters": [{ "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Menu item updated and audited" } }
      }
    },
    "/restaurant/menu/items/{itemId}/availability": {
      "patch": {
        "summary": "Toggle menu item live kitchen stock and availability (audited)",
        "tags": ["Catalog"],
        "parameters": [{ "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Availability updated and audited" } }
      }
    },
    "/safety/outlets/{id}": {
      "get": {
        "summary": "Fetch canonical public Bhojora Trust profile for an outlet",
        "security": [],
        "tags": ["Trust Profile"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Verified score, audit date, photo hashes, and FSSAI notice" } }
      }
    },
    "/safety/outlets/{id}/history": {
      "get": {
        "summary": "Fetch immutable historical audit versions for an outlet",
        "security": [],
        "tags": ["Trust Profile"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Array of immutable historical inspection reports" } }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get active single-outlet user cart (recomputed live against current catalog prices)",
        "tags": ["Cart & Ordering"],
        "responses": {
          "200": { "description": "Active customer cart with integer paise line totals and price-change flags" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Permission order:own:read required" }
        }
      },
      "delete": {
        "summary": "Clear all items from the authenticated customer cart",
        "tags": ["Cart & Ordering"],
        "responses": {
          "200": { "description": "Empty cart returned" },
          "401": { "description": "Authentication required" }
        }
      }
    },
    "/cart/items": {
      "post": {
        "summary": "Add or increment menu item with authoritative variant/addon lookup and one-outlet enforcement",
        "tags": ["Cart & Ordering"],
        "responses": {
          "200": { "description": "Updated cart computed from authoritative server catalog prices" },
          "400": { "description": "VALIDATION_ERROR (invalid options, quantity, or prohibited client monetary fields)" },
          "409": { "description": "SINGLE_OUTLET_CONFLICT (unless replaceOutlet=true) or CRITICAL_VIOLATION_SUSPENDED" }
        }
      }
    },
    "/cart/items/{cartItemId}": {
      "patch": {
        "summary": "Update item quantity (0 deletes line) or customization choices",
        "tags": ["Cart & Ordering"],
        "parameters": [{ "name": "cartItemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Updated cart" },
          "400": { "description": "VALIDATION_ERROR including prohibited client monetary fields" },
          "404": { "description": "Cart line item not found" }
        }
      },
      "delete": {
        "summary": "Remove a single line item from customer cart",
        "tags": ["Cart & Ordering"],
        "parameters": [{ "name": "cartItemId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Updated cart after deletion" },
          "404": { "description": "Cart line item not found" }
        }
      }
    },
    "/coupons/available": {
      "get": {
        "summary": "List active promotional coupons with transparent platform vs. restaurant funding split percentages",
        "tags": ["Cart & Ordering"],
        "responses": {
          "200": { "description": "Array of active public coupon summaries" }
        }
      }
    },
    "/checkout/quote": {
      "post": {
        "summary": "Generate HMAC-SHA256 signed server-authoritative pricing quote in integer paise (600s TTL)",
        "tags": ["Cart & Ordering"],
        "responses": {
          "200": { "description": "Signed quoteId valid for 600 seconds with delivery fee, packaging, GST (CGST+SGST), coupon funding split, untaxed tip, and price-drift detection" },
          "400": { "description": "Empty cart, coupon rule failure, or prohibited client monetary fields" },
          "403": { "description": "Address ownership or permission check failed" },
          "409": { "description": "Outlet suspended or closed" }
        }
      }
    },
    "/checkout/quotes/{quoteId}": {
      "get": {
        "summary": "Fetch an owned checkout quote with live expiration status",
        "tags": ["Cart & Ordering"],
        "parameters": [{ "name": "quoteId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Owned quote details" },
          "403": { "description": "Cross-customer access forbidden" },
          "404": { "description": "Quote not found" }
        }
      }
    },
    "/checkout/quotes/{quoteId}/verify": {
      "post": {
        "summary": "Verify quote ownership, 600s TTL expiry, and HMAC-SHA256 integrity before order creation",
        "tags": ["Cart & Ordering"],
        "parameters": [{ "name": "quoteId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Quote integrity and remaining validity confirmed" },
          "403": { "description": "Cross-customer access forbidden or HMAC integrity check failed" },
          "409": { "description": "Quote expired after 600s or total mismatch" }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create order from authoritative quoteId",
        "tags": ["Cart & Ordering"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "201": { "description": "Order created in AWAITING_PAYMENT state" } }
      },
      "get": {
        "summary": "List user orders",
        "tags": ["Cart & Ordering"],
        "responses": { "200": { "description": "Paginated user order history" } }
      }
